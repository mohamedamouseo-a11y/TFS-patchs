@@ -0,0 +1,94 @@
+const DRIVE_FOLDER_MIME_TYPE = "application/vnd.google-apps.folder";
+
+export const TFS_DATABASE_BACKUP_FOLDER_NAME = "TFS database backup";
+
+interface DriveFolder {
+  folderId: string;
+  folderName: string;
+  created: boolean;
+}
+
+function escapeDriveQueryLiteral(value: string): string {
+  return value.replace(/\\/g, "\\\\").replace(/'/g, "\\'");
+}
+
+async function readDriveError(res: Response): Promise<string> {
+  const text = await res.text();
+  return text || res.statusText || "Unknown Google Drive error";
+}
+
+export async function ensureTfsDatabaseBackupFolder(accessToken: string): Promise<DriveFolder> {
+  const escapedName = escapeDriveQueryLiteral(TFS_DATABASE_BACKUP_FOLDER_NAME);
+  const q = [
+    "'root' in parents",
+    `name = '${escapedName}'`,
+    `mimeType = '${DRIVE_FOLDER_MIME_TYPE}'`,
+    "trashed = false",
+  ].join(" and ");
+
+  const searchParams = new URLSearchParams({
+    q,
+    spaces: "drive",
+    corpora: "user",
+    pageSize: "10",
+    orderBy: "createdTime",
+    fields: "files(id,name,parents,driveId,shared)",
+  });
+  const searchRes = await fetch(
+    `https://www.googleapis.com/drive/v3/files?${searchParams.toString()}`,
+    { headers: { Authorization: `Bearer ${accessToken}` } },
+  );
+  if (!searchRes.ok) {
+    throw new Error(`Drive folder lookup failed (${searchRes.status}): ${await readDriveError(searchRes)}`);
+  }
+
+  const searchData = (await searchRes.json()) as {
+    files?: Array<{ id?: string; name?: string; driveId?: string; shared?: boolean }>;
+  };
+  const existing = (searchData.files ?? []).find((file) => file.id && !file.driveId && file.shared !== true);
+  if (existing?.id) {
+    return {
+      folderId: existing.id,
+      folderName: existing.name || TFS_DATABASE_BACKUP_FOLDER_NAME,
+      created: false,
+    };
+  }
+
+  const createRes = await fetch(
+    "https://www.googleapis.com/drive/v3/files?fields=id,name,parents,driveId,shared",
+    {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${accessToken}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({
+        name: TFS_DATABASE_BACKUP_FOLDER_NAME,
+        mimeType: DRIVE_FOLDER_MIME_TYPE,
+        parents: ["root"],
+      }),
+    },
+  );
+  if (!createRes.ok) {
+    throw new Error(`Drive folder creation failed (${createRes.status}): ${await readDriveError(createRes)}`);
+  }
+
+  const created = (await createRes.json()) as {
+    id?: string;
+    name?: string;
+    driveId?: string;
+    shared?: boolean;
+  };
+  if (!created.id) {
+    throw new Error("Drive folder creation response missing folder id");
+  }
+  if (created.driveId || created.shared === true) {
+    throw new Error("Refusing to use a shared folder for TFS database backups");
+  }
+
+  return {
+    folderId: created.id,
+    folderName: created.name || TFS_DATABASE_BACKUP_FOLDER_NAME,
+    created: true,
+  };
+}
