+async function createTemporaryReconcileStash(
+  operationId: string,
+  env: NodeJS.ProcessEnv,
+): Promise<string> {
+  const before = await git(["rev-parse", "-q", "--verify", "refs/stash"], env);
+  const previousSha = before.code === 0 ? before.stdout.trim() : "";
+  const stash = await git(
+    ["stash", "push", "--include-untracked", "--message", `tfs-developer-hub-reconcile-${operationId}`],
+    env,
+  );
+  if (stash.code !== 0) throw new Error(stash.stderr || "Failed to preserve local changes before fast-forward");
+
+  const after = await git(["rev-parse", "-q", "--verify", "refs/stash"], env);
+  const stashSha = after.code === 0 ? after.stdout.trim() : "";
+  if (!stashSha || stashSha === previousSha) {
+    throw new Error("Failed to create temporary reconciliation stash");
+  }
+  return stashSha;
+}
+
+async function applyTemporaryReconcileStash(stashSha: string, env: NodeJS.ProcessEnv): Promise<void> {
+  const apply = await git(["stash", "apply", "--index", stashSha], env);
+  if (apply.code !== 0) {
+    throw new Error(
+      apply.stderr ||
+        "Local changes could not be restored automatically after fast-forward; the operation will roll back",
+    );
+  }
+}
+
+async function dropTemporaryReconcileStash(stashSha: string, env?: NodeJS.ProcessEnv): Promise<void> {
+  const top = await git(["rev-parse", "-q", "--verify", "refs/stash"], env);
+  if (top.code !== 0 || top.stdout.trim() !== stashSha) return;
+  const drop = await git(["stash", "drop", "stash@{0}"], env);
+  if (drop.code !== 0) throw new Error(drop.stderr || "Failed to remove temporary reconciliation stash");
+}
