new file mode 100644
--- /dev/null
+++ b/server/lib/google-request.ts
@@ -0,0 +1,45 @@
+export const GOOGLE_OAUTH_TIMEOUT_MS = 12_000;
+export const GOOGLE_DRIVE_METADATA_TIMEOUT_MS = 10_000;
+export const GOOGLE_DRIVE_UPLOAD_TIMEOUT_MS = 45_000;
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+export async function fetchGoogleWithTimeout(
+  stage: string,
+  url: string,
+  init: RequestInit = {},
+  timeoutMs: number = GOOGLE_DRIVE_METADATA_TIMEOUT_MS,
+): Promise<Response> {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  const startedAt = Date.now();
+
+  console.info(`[google:${stage}] start timeoutMs=${timeoutMs}`);
+
+  try {
+    const response = await fetch(url, {
+      ...init,
+      signal: controller.signal,
+    });
+    console.info(
+      `[google:${stage}] response status=${response.status} durationMs=${Date.now() - startedAt}`,
+    );
+    return response;
+  } catch (error) {
+    const durationMs = Date.now() - startedAt;
+    if (controller.signal.aborted) {
+      const message = `${stage} timed out after ${timeoutMs}ms`;
+      console.warn(`[google:${stage}] timeout durationMs=${durationMs}`);
+      throw new Error(message);
+    }
+
+    console.error(
+      `[google:${stage}] failed durationMs=${durationMs} error=${errorMessage(error)}`,
+    );
+    throw error;
+  } finally {
+    clearTimeout(timer);
+  }
+}
